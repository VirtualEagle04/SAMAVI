generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(50)
  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("rol")
}

model Permiso {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique @db.VarChar(50)
  descripcion String       @db.VarChar(150)
  roles       RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  idRol     Int     @map("id_rol")
  idPermiso Int     @map("id_permiso")
  rol       Rol     @relation(fields: [idRol], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [idPermiso], references: [id], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@map("rol_permiso")
}

model Usuario {
  id           Int    @id @default(autoincrement())
  nombre       String @db.VarChar(100)
  login        String @unique @db.VarChar(50)
  passwordHash String @map("password_hash") @db.VarChar(255)
  contacto     Json?
  idRol        Int    @map("id_rol")
  rol          Rol    @relation(fields: [idRol], references: [id])

  @@map("usuario")
}

model Galpon {
  id               Int             @id @default(autoincrement())
  nombre           String          @db.VarChar(100)
  gallinasActuales Int             @map("gallinas_actuales")
  estado           String          @db.VarChar(20)
  conteos          LogConteo[]
  cierres          CierreDiario[]
  cierresProduccion CierreProduccionDia[]
  bodegas          Bodega[]
  despachos        DetalleVentaGalpon[]

  @@map("galpon")
}

model CategoriaPeso {
  codigo       String          @id @db.VarChar(10)
  nombre       String          @db.VarChar(30)
  pesoMinG     Int?            @map("peso_min_g")
  pesoMaxG     Int?            @map("peso_max_g")
  conteos      LogConteo[]
  cierres      CierreDiario[]
  bodegas      Bodega[]
  precios      Precio[]
  detallesPedido DetallePedido[]
  detallesVenta DetalleVenta[]

  @@map("categoria_peso")
}

model LogConteo {
  id                  BigInt        @id @default(autoincrement())
  timestamp           DateTime
  cantidad            Int
  idGalpon            Int           @map("id_galpon")
  codigoCategoriaPeso String        @map("codigo_categoria_peso") @db.VarChar(10)
  galpon              Galpon        @relation(fields: [idGalpon], references: [id], onDelete: Restrict)
  categoriaPeso       CategoriaPeso @relation(fields: [codigoCategoriaPeso], references: [codigo], onDelete: Restrict)

  @@index([idGalpon, codigoCategoriaPeso, timestamp])
  @@map("log_conteo")
}

model CierreDiario {
  idGalpon            Int           @map("id_galpon")
  codigoCategoriaPeso String        @map("codigo_categoria_peso") @db.VarChar(10)
  fecha               DateTime      @db.Date
  cantidadBandejas    Int           @map("cantidad_bandejas")
  cantidadSobrante    Int           @map("cantidad_sobrante")
  galpon              Galpon        @relation(fields: [idGalpon], references: [id], onDelete: Restrict)
  categoriaPeso       CategoriaPeso @relation(fields: [codigoCategoriaPeso], references: [codigo], onDelete: Restrict)

  @@id([idGalpon, codigoCategoriaPeso, fecha])
  @@index([fecha])
  @@map("cierre_diario")
}

model CierreProduccionDia {
  idGalpon  Int      @map("id_galpon")
  fecha     DateTime @db.Date
  cerradoEn DateTime @default(now()) @map("cerrado_en")
  galpon    Galpon   @relation(fields: [idGalpon], references: [id], onDelete: Restrict)

  @@id([idGalpon, fecha])
  @@index([fecha])
  @@map("cierre_produccion_dia")
}

model Bodega {
  idGalpon            Int           @map("id_galpon")
  codigoCategoriaPeso String        @map("codigo_categoria_peso") @db.VarChar(10)
  fechaCorte          DateTime      @map("fecha_corte") @db.Date
  cantidadBandejas    Int           @map("cantidad_bandejas")
  galpon              Galpon        @relation(fields: [idGalpon], references: [id], onDelete: Restrict)
  categoriaPeso       CategoriaPeso @relation(fields: [codigoCategoriaPeso], references: [codigo], onDelete: Restrict)

  @@id([idGalpon, codigoCategoriaPeso, fechaCorte])
  @@index([fechaCorte])
  @@map("bodega")
}

model Insumo {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique @db.VarChar(30)
  nombre        String    @db.VarChar(150)
  descripcion   String?   @db.Text
  unidadMedida  String    @db.VarChar(20) @map("unidad_medida")
  stockMinimo   Decimal   @default(0) @db.Decimal(10, 2) @map("stock_minimo")
  costo         Decimal   @default(0) @db.Decimal(12, 2)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  detallesCompra DetalleCompraInsumo[]
  movimientos   MovimientoInsumo[]

  @@map("insumo")
}

model Proveedor {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(150)
  contacto  Json?
  activo    Boolean   @default(true)
  creadoEn  DateTime  @default(now()) @map("creado_en")
  compras   CompraInsumo[]

  @@map("proveedor")
}

model CompraInsumo {
  id               Int       @id @default(autoincrement())
  fecha            DateTime
  idProveedor      Int       @map("id_proveedor")
  numeroFactura    String?   @db.VarChar(50) @map("numero_factura")
  reciboImagen     Bytes?    @map("recibo_imagen")
  reciboMimeType   String?   @db.VarChar(50) @map("recibo_mime_type")
  reciboNombreArchivo String? @db.VarChar(200) @map("recibo_nombre_archivo")
  observaciones    String?   @db.Text
  total            Decimal   @db.Decimal(12, 2)
  creadoEn         DateTime  @default(now()) @map("creado_en")
  proveedor        Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Restrict)
  detalles         DetalleCompraInsumo[]
  movimientos      MovimientoInsumo[]

  @@map("compra_insumo")
}

model DetalleCompraInsumo {
  idCompra           Int       @map("id_compra")
  idInsumo           Int       @map("id_insumo")
  cantidad           Decimal   @db.Decimal(10, 2)
  costoUnitario      Decimal   @db.Decimal(12, 2) @map("costo_unitario")
  subtotal           Decimal   @db.Decimal(12, 2)
  lote               String?   @db.VarChar(50)
  fechaVencimiento   DateTime? @db.Date @map("fecha_vencimiento")
  compra             CompraInsumo @relation(fields: [idCompra], references: [id], onDelete: Cascade)
  insumo             Insumo    @relation(fields: [idInsumo], references: [id], onDelete: Restrict)

  @@id([idCompra, idInsumo])
  @@map("detalle_compra_insumo")
}

model TipoMovimientoInsumo {
  codigo      String   @id @db.VarChar(20)
  nombre      String   @db.VarChar(50)
  efecto      String   @db.VarChar(10)
  descripcion String?  @db.VarChar(200)
  movimientos MovimientoInsumo[]

  @@map("tipo_movimiento_insumo")
}

model MovimientoInsumo {
  id                   BigInt   @id @default(autoincrement())
  fecha                DateTime @default(now())
  idInsumo             Int      @map("id_insumo")
  codigoTipoMovimiento String   @db.VarChar(20) @map("codigo_tipo_movimiento")
  idGalpon             Int?     @map("id_galpon")
  cantidad             Decimal  @db.Decimal(10, 2)
  costoUnitario        Decimal? @db.Decimal(12, 2) @map("costo_unitario")
  idCompra             Int?     @map("id_compra")
  idCierreDiario       Int?     @map("id_cierre_diario")
  observaciones        String?  @db.Text
  idUsuario            Int      @map("id_usuario")
  insumo               Insumo   @relation(fields: [idInsumo], references: [id], onDelete: Restrict)
  tipoMovimiento       TipoMovimientoInsumo @relation(fields: [codigoTipoMovimiento], references: [codigo], onDelete: Restrict)
  compra               CompraInsumo? @relation(fields: [idCompra], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([idGalpon, idInsumo])
  @@map("movimiento_insumo")
}

model Mayorista {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(150)
  ubicacion String?   @db.VarChar(150)
  contacto  Json?
  precios   Precio[]
  pedidos   Pedido[]

  @@map("mayorista")
}

model Precio {
  idMayorista         Int           @map("id_mayorista")
  codigoCategoriaPeso String        @map("codigo_categoria_peso") @db.VarChar(10)
  valorUnitario       Decimal       @map("valor_unitario") @db.Decimal(10, 2)
  mayorista           Mayorista     @relation(fields: [idMayorista], references: [id], onDelete: Cascade)
  categoriaPeso       CategoriaPeso @relation(fields: [codigoCategoriaPeso], references: [codigo], onDelete: Restrict)

  @@id([idMayorista, codigoCategoriaPeso])
  @@map("precio")
}

model Pedido {
  id          Int             @id @default(autoincrement())
  fecha       DateTime
  estado      String          @db.VarChar(20)
  idMayorista Int             @map("id_mayorista")
  mayorista   Mayorista       @relation(fields: [idMayorista], references: [id], onDelete: Restrict)
  detalles    DetallePedido[]
  venta       Venta?

  @@index([estado, fecha])
  @@index([idMayorista, fecha])
  @@map("pedido")
}

model DetallePedido {
  idPedido            Int           @map("id_pedido")
  codigoCategoriaPeso String        @map("codigo_categoria_peso") @db.VarChar(10)
  cantidadSolicitada  Int           @map("cantidad_solicitada")
  pedido              Pedido        @relation(fields: [idPedido], references: [id], onDelete: Cascade)
  categoriaPeso       CategoriaPeso @relation(fields: [codigoCategoriaPeso], references: [codigo], onDelete: Restrict)

  @@id([idPedido, codigoCategoriaPeso])
  @@map("detalle_pedido")
}

model Venta {
  id        Int            @id @default(autoincrement())
  fechaHora DateTime       @map("fecha_hora")
  idPedido  Int            @unique @map("id_pedido")
  pedido    Pedido         @relation(fields: [idPedido], references: [id], onDelete: Restrict)
  detalles  DetalleVenta[]

  @@index([fechaHora])
  @@map("venta")
}

model DetalleVenta {
  idVenta             Int           @map("id_venta")
  codigoCategoriaPeso String        @map("codigo_categoria_peso") @db.VarChar(10)
  cantidadVendida     Int           @map("cantidad_vendida")
  cantidadNoEntregada Int           @default(0) @map("cantidad_no_entregada")
  motivoNoEntrega     String?       @map("motivo_no_entrega") @db.VarChar(30)
  precioAplicado      Decimal       @map("precio_aplicado") @db.Decimal(10, 2)
  venta               Venta         @relation(fields: [idVenta], references: [id], onDelete: Cascade)
  categoriaPeso       CategoriaPeso @relation(fields: [codigoCategoriaPeso], references: [codigo], onDelete: Restrict)
  distribuciones      DetalleVentaGalpon[]

  @@id([idVenta, codigoCategoriaPeso])
  @@map("detalle_venta")
}

model DetalleVentaGalpon {
  idVenta             Int           @map("id_venta")
  codigoCategoriaPeso String        @map("codigo_categoria_peso") @db.VarChar(10)
  idGalpon            Int           @map("id_galpon")
  cantidad            Int
  detalleVenta        DetalleVenta  @relation(fields: [idVenta, codigoCategoriaPeso], references: [idVenta, codigoCategoriaPeso], onDelete: Cascade)
  galpon              Galpon        @relation(fields: [idGalpon], references: [id], onDelete: Restrict)

  @@id([idVenta, codigoCategoriaPeso, idGalpon])
  @@index([idGalpon, codigoCategoriaPeso])
  @@map("detalle_venta_galpon")
}

