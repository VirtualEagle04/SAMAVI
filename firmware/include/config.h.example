#ifndef CONFIG_H
#define CONFIG_H

const char* WIFI_SSID = "WIFI_SSID";
const char* WIFI_PASSWORD = "WIFI_PASSWORD";
const char* MQTT_SERVER = "MACHINE_IP_MQTT_SERVER";
const uint16_t MQTT_PORT = 1883;

// Rango en el que pasan los huevos frente a los VL53L0X (medido en el montaje).
// Un huevo cuenta con una lectura válida entre MIN y MAX.
const uint16_t DISTANCIA_MIN_MM = 60;
const uint16_t DISTANCIA_MAX_MM = 170;
// Debounce: tras contar un huevo, el mismo sensor no vuelve a contar hasta que
// pase este tiempo y vea el canal libre (evita contar dos veces el mismo huevo).
const unsigned long DEBOUNCE_MS = 300;

#endif