# PostgreSQL
# En producción la contraseña va dentro de DATABASE_URL: usa solo letras,
# números, "-" y "_" para no tener que codificarla.
POSTGRES_DB=samavi
POSTGRES_USER=samavi
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=15432

# MQTT
MOSQUITTO_PORT=1883

# Backend
PORT=3001
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=samavi/conteo
MQTT_CLIENT_ID=samavi-backend
# Vacías = conexión anónima (Mosquitto local). En producción el usuario es
# samavi-backend (infra/prod/mosquitto/acl) y la contraseña la que crees con
# infra/prod/scripts/mqtt-usuario.sh samavi-backend.
MQTT_USERNAME=
MQTT_PASSWORD=
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
DATABASE_URL=postgresql://samavi:change_this_local_password@localhost:15432/samavi

# Producción (infra/prod, docs/deployment.md). En producción el compose arma
# DATABASE_URL y MQTT_URL hacia los contenedores e ignora PORT, POSTGRES_PORT,
# MOSQUITTO_PORT, DATABASE_URL y MQTT_URL de este archivo.
DOMAIN=samavi.example.com
LETSENCRYPT_EMAIL=correo@example.com
# Dueño del repositorio en GitHub, en minúsculas (imágenes ghcr.io/<dueño>/samavi-*).
GHCR_OWNER=virtualeagle04
